TIDE_AND_SEEK_ENVIRONMENT=production
TIDE_AND_SEEK_DATABASE_URL=postgresql+psycopg://tide_and_seek:replace-me@db:5432/tide_and_seek
TIDE_AND_SEEK_DATA_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
TIDE_AND_SEEK_CURSOR_SIGNING_KEY=replace-with-another-base64url-32-byte-key
TIDE_AND_SEEK_TRUSTED_HOSTS=["relay.example.com","127.0.0.1","localhost"]
TIDE_AND_SEEK_FORWARDED_ALLOW_IPS=127.0.0.1
TIDE_AND_SEEK_VOYAGE_RETENTION_HOURS=72
TIDE_AND_SEEK_ENDED_VOYAGE_GRACE_HOURS=24
TIDE_AND_SEEK_JOIN_CODE_LOOKUP_RATE_LIMIT_REQUESTS=30
TIDE_AND_SEEK_JOIN_CODE_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=60
