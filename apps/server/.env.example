TIDE_AND_SEEK_TRAFFIC_INCIDENT_RATE_LIMIT_WINDOW_SECONDS=60
TIDE_AND_SEEK_TRAFFIC_INCIDENT_MAXIMUM_RESPONSE_BYTES=524288
TIDE_AND_SEEK_PROTOCOL_VERSION=1
TIDE_AND_SEEK_MINIMUM_CLIENT_PROTOCOL=1
TIDE_AND_SEEK_SUPPORTED_CAPABILITIES=["voyage-start-v1","membership-v1","route-revisions-v1","pre-start-presence-v1","push-notifications-v1","observer-access-v1","traffic-incidents-v1"]
