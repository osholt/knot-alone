TIDE_AND_SEEK_MAXIMUM_ACTIVE_VOYAGES=100
TIDE_AND_SEEK_MAXIMUM_EVENTS_PER_VOYAGE=5000
TIDE_AND_SEEK_MAXIMUM_STORED_BYTES_PER_VOYAGE=26214400
TIDE_AND_SEEK_MAXIMUM_REPLAYS_PER_VOYAGE=5000
TIDE_AND_SEEK_MAXIMUM_REPLAY_BYTES_PER_VOYAGE=26214400
TIDE_AND_SEEK_PRE_START_PRESENCE_TTL_SECONDS=45
TIDE_AND_SEEK_MAXIMUM_PRE_START_PRESENCE_RIDERS=200
TIDE_AND_SEEK_OBSERVER_READ_RATE_LIMIT_REQUESTS=120
TIDE_AND_SEEK_OBSERVER_READ_RATE_LIMIT_WINDOW_SECONDS=60
TIDE_AND_SEEK_OBSERVER_IP_ABUSE_RATE_LIMIT_REQUESTS=5000
