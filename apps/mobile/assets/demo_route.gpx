<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Tide and Seek" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Lymington to Cowes</name>
    <desc>A demonstration passage of about 8.6 nautical miles across the Solent, in four legs. Mark positions are approximate and chosen to show how the app works. This is not a planned passage: it has not been checked against the chart, the tide or the traffic, and it must not be used for navigation.</desc>
  </metadata>
  <wpt lat="50.737800" lon="-1.509500">
    <name>Lymington River entrance</name>
    <desc>Leave the river and turn east into the Solent.</desc>
    <sym>Navaid, Green</sym>
  </wpt>
  <wpt lat="50.733000" lon="-1.440000">
    <name>Mid Solent, off Hamstead</name>
    <desc>Open water. Watch for the Yarmouth and Lymington ferries.</desc>
    <sym>Navaid, Green</sym>
  </wpt>
  <wpt lat="50.743000" lon="-1.385000">
    <name>Off Salt Mead</name>
    <desc>Hold the island shore out of the worst of the west-going stream.</desc>
    <sym>Navaid, Green</sym>
  </wpt>
  <wpt lat="50.770000" lon="-1.315000">
    <name>Gurnard, Cowes approach</name>
    <desc>Come round for the harbour entrance.</desc>
    <sym>Navaid, Green</sym>
  </wpt>
  <wpt lat="50.768000" lon="-1.298000">
    <name>Cowes harbour entrance</name>
    <desc>Call the harbour before entering; give way to the chain ferry.</desc>
    <sym>Navaid, Green</sym>
  </wpt>
  <trk>
    <name>Lymington to Cowes passage</name>
    <desc>Rhumb-line legs between the marks.</desc>
